<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WorkStation.App.ViewModels"
             xmlns:controls="using:WorkStation.App.Controls"
             x:Class="WorkStation.App.Views.ProjectsView"
             x:DataType="vm:ProjectsViewModel"
             x:CompileBindings="True">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseFormCommand}" />
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SaveFormCommand}" />
  </UserControl.KeyBindings>

  <Grid RowDefinitions="Auto,Auto,*">

    <!-- 工具栏：主操作靠右（与标题区同一视觉轴），次操作留左 -->
    <Grid Grid.Row="0"
          Margin="28,0,28,16"
          ColumnDefinitions="Auto,*,Auto">
      <CheckBox VerticalAlignment="Center"
                Content="显示已归档"
                IsChecked="{Binding IncludeArchived, Mode=TwoWay}" />
      <TextBlock Grid.Column="1"
                 Margin="16,0,0,0"
                 VerticalAlignment="Center"
                 Classes="dim"
                 FontSize="{DynamicResource FontXs}"
                 Text="{Binding Projects.Count, StringFormat='共 {0} 个项目'}" />
      <Button Grid.Column="2"
              Content="新建项目"
              Classes="primary"
              Command="{Binding NewProjectCommand}" />
    </Grid>

    <!-- 错误条：与空状态互斥，避免「加载失败」和「还没有项目」同屏 -->
    <Border Grid.Row="1"
            Classes="error-bar"
            IsVisible="{Binding HasError}"
            Margin="28,0,28,16">
      <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
    </Border>

    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="{DynamicResource PagePadding}">

        <ItemsControl ItemsSource="{Binding Projects}" IsVisible="{Binding HasProjects}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ProjectCardViewModel">
              <Border Classes="card" Width="306" Margin="0,0,16,16" Padding="16,15,16,0">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto">

                  <!-- 标题 + 状态 -->
                  <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Name}"
                               FontSize="14.5"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0">
                      <Border Classes="chip" IsVisible="{Binding IsArchived}">
                        <TextBlock Text="已归档" />
                      </Border>
                      <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Ellipse Width="6"
                                 Height="6"
                                 Fill="{Binding StatusBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="{DynamicResource FontMicro}"
                                   Foreground="{DynamicResource TextDimBrush}" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>

                  <!-- 描述占固定高度：卡片底部才能对齐，否则长短不一像没排版 -->
                  <Border Grid.Row="1" Height="34" Margin="0,6,0,0">
                    <TextBlock Text="{Binding Description}"
                               Classes="dim"
                               FontSize="{DynamicResource FontSm}"
                               MaxLines="2"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding HasDescription}" />
                  </Border>

                  <!-- 进度 + 统计 -->
                  <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,8,0,0">
                    <Grid Width="42" Height="42" VerticalAlignment="Center">
                      <controls:ProgressRing Value="{Binding Progress}"
                                             Thickness="4"
                                             RingBrush="{Binding RingBrush}"
                                             TrackBrush="{DynamicResource BgSunkenBrush}" />
                      <TextBlock Text="{Binding ProgressText}"
                                 FontSize="10.5"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Column="1"
                                Margin="12,0,0,0"
                                Spacing="3"
                                VerticalAlignment="Center">
                      <TextBlock Text="{Binding MetaText}"
                                 FontSize="{DynamicResource FontXs}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding OverdueText}"
                                   FontSize="{DynamicResource FontXs}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DangerBrush}"
                                   IsVisible="{Binding HasOverdue}" />
                        <TextBlock Text="{Binding DueText}"
                                   FontSize="{DynamicResource FontXs}"
                                   Classes="dim" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>

                  <!-- 操作：图标按钮，含义靠 tooltip 兜底；删除只在悬停时转红 -->
                  <Border Grid.Row="3"
                          Margin="0,14,-16,-1"
                          Padding="12,6"
                          BorderThickness="0,1,0,0"
                          BorderBrush="{DynamicResource LineBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <Button Classes="icon sm" Command="{Binding EditCommand}" ToolTip.Tip="编辑">
                        <controls:Icon Kind="Edit" Size="13" />
                      </Button>
                      <Button Classes="icon sm"
                              Command="{Binding ToggleArchiveCommand}"
                              ToolTip.Tip="{Binding ArchiveLabel}">
                        <Panel>
                          <controls:Icon Kind="Archive" Size="13" IsVisible="{Binding !IsArchived}" />
                          <controls:Icon Kind="Unarchive" Size="13" IsVisible="{Binding IsArchived}" />
                        </Panel>
                      </Button>
                      <Button Classes="icon sm dangerish" Command="{Binding DeleteCommand}" ToolTip.Tip="删除">
                        <controls:Icon Kind="Trash" Size="13" />
                      </Button>
                    </StackPanel>
                  </Border>

                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 空状态 -->
        <Border IsVisible="{Binding ShowEmpty}"
                Padding="48"
                CornerRadius="{DynamicResource RadiusLg}"
                BorderThickness="1"
                BorderBrush="{DynamicResource LineBrush}">
          <StackPanel Spacing="7" HorizontalAlignment="Center">
            <TextBlock Text="还没有项目"
                       FontSize="15"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="建一个项目，把相关任务收在一起，进度会自动算。"
                       Classes="dim"
                       FontSize="{DynamicResource FontSm}"
                       HorizontalAlignment="Center" />
            <Button Content="新建项目"
                    Classes="primary"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0"
                    Command="{Binding NewProjectCommand}" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- 表单抽屉 -->
    <Border Grid.RowSpan="3"
            IsVisible="{Binding IsFormOpen}"
            Background="{DynamicResource ScrimBrush}">
      <Border Classes="drawer"
              Width="460"
              HorizontalAlignment="Right">
        <ContentControl Content="{Binding Form}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:ProjectFormViewModel">
              <Grid RowDefinitions="Auto,*,Auto">

                <Border Grid.Row="0"
                        Padding="22,18"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource LineBrush}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Title}" Classes="section-title" VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Classes="icon"
                            Command="{Binding CancelCommand}"
                            ToolTip.Tip="关闭（Esc）">
                      <controls:Icon Kind="Close" Size="13" />
                    </Button>
                  </Grid>
                </Border>

                <ScrollViewer Grid.Row="1">
                  <StackPanel Margin="22,18,22,22" Spacing="16">

                    <StackPanel Spacing="0">
                      <TextBlock Text="名称" Classes="label" />
                      <TextBox Text="{Binding Name, Mode=TwoWay}" PlaceholderText="例如：重构工作台" />
                    </StackPanel>

                    <StackPanel Spacing="0">
                      <TextBlock Text="描述" Classes="label" />
                      <TextBox Text="{Binding Description, Mode=TwoWay}"
                               AcceptsReturn="True"
                               TextWrapping="Wrap"
                               MinHeight="74"
                               PlaceholderText="这个项目要达成什么" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                      <StackPanel Spacing="0">
                        <TextBlock Text="状态" Classes="label" />
                        <ComboBox ItemsSource="{x:Static vm:ProjectFormViewModel.StatusOptions}"
                                  SelectedIndex="{Binding StatusIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="0">
                        <TextBlock Text="优先级" Classes="label" />
                        <ComboBox ItemsSource="{x:Static vm:ProjectFormViewModel.PriorityOptions}"
                                  SelectedIndex="{Binding PriorityIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                      </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                      <StackPanel Spacing="0">
                        <TextBlock Text="开始日期" Classes="label" />
                        <controls:DueDateField SelectedDate="{Binding StartDate, Mode=TwoWay}"
                                               ShowTime="False"
                                               Watermark="不设置" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="0">
                        <TextBlock Text="目标日期" Classes="label" />
                        <controls:DueDateField SelectedDate="{Binding DueDate, Mode=TwoWay}"
                                               ShowTime="False"
                                               Watermark="不设置" />
                      </StackPanel>
                    </Grid>

                    <StackPanel Spacing="0">
                      <TextBlock Text="进度" Classes="label" />
                      <ComboBox ItemsSource="{x:Static vm:ProjectFormViewModel.ProgressModeOptions}"
                                SelectedIndex="{Binding ProgressModeIndex, Mode=TwoWay}"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Spacing="0" IsVisible="{Binding IsManualProgress}">
                      <TextBlock Text="手动进度（0–100）" Classes="label" />
                      <TextBox Text="{Binding ProgressManual, Mode=TwoWay}" PlaceholderText="0" />
                    </StackPanel>

                    <Border Classes="error-bar"
                            IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
                    </Border>

                  </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Padding="22,14"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource LineBrush}">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="取消" Command="{Binding CancelCommand}" />
                    <Button Content="保存" Classes="primary" Command="{Binding SaveCommand}" />
                  </StackPanel>
                </Border>

              </Grid>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </Border>
    </Border>

    <!-- 永久删除确认 -->
    <Border Grid.RowSpan="3"
            IsVisible="{Binding IsDeleteConfirmOpen}"
            Background="{DynamicResource ScrimBrush}">
      <Border Classes="card" Width="440" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="14">
          <TextBlock Text="永久删除项目？" Classes="section-title" />
          <StackPanel Spacing="5">
            <TextBlock Text="{Binding PendingDelete.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="该项目下的所有任务会一并删除，无法恢复。只想暂时隐藏，请用「归档」。"
                       Classes="dim"
                       FontSize="{DynamicResource FontSm}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="取消" Command="{Binding CancelDeleteCommand}" />
            <Button Content="永久删除" Classes="danger" Command="{Binding ConfirmDeleteCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

  </Grid>
</UserControl>
