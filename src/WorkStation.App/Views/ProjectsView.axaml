<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WorkStation.App.ViewModels"
             xmlns:controls="using:WorkStation.App.Controls"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             x:Class="WorkStation.App.Views.ProjectsView"
             x:DataType="vm:ProjectsViewModel"
             x:CompileBindings="True">


  <Grid RowDefinitions="Auto,Auto,*">

    <!-- 工具栏：主操作靠右（与标题区同一视觉轴），次操作留左；整条收进一张卡。
         下边距 14：和页面头、和下面的项目卡片都要留出缝。 -->
    <Border Grid.Row="0"
            Classes="card"
            Margin="{DynamicResource PageGutterBelowHeader}"
            Padding="10,8">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <CheckBox VerticalAlignment="Center"
                  Content="显示已归档"
                  IsChecked="{Binding IncludeArchived, Mode=TwoWay}" />
        <TextBlock Grid.Column="1"
                   Margin="16,0,0,0"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource SukiMuteText}"
                   Text="{Binding Projects.Count, StringFormat='共 {0} 个项目'}" />
        <Button Grid.Column="2"
                Content="新建项目"
                Classes="Flat"
                Command="{Binding NewProjectCommand}" />
      </Grid>
    </Border>

    <!-- 错误条：与空状态互斥，避免「加载失败」和「还没有项目」同屏 -->
    <suki:InfoBar Grid.Row="1"
            IsVisible="{Binding HasError}"
            Margin="{DynamicResource PageGutter}" Message="{Binding Error}" Severity="Error" IsClosable="False" />

    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="{DynamicResource PageGutterBottom}">

        <ItemsControl ItemsSource="{Binding Projects}" IsVisible="{Binding HasProjects}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ProjectCardViewModel">
              <suki:GlassCard Classes="card" Width="306" Margin="0,0,16,16" Padding="16,15,16,0">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto">

                  <!--
                    优先级不再用左边那条 3px 竖条。
                    色条是从卡片内边距（16px）往里的，既不贴边也不圆角，
                    看着像一条画歪的红线；而且它在 RowSpan 里一路贯到操作区，
                    卡片被它劈成两半。改成标题行右侧的一枚小胶囊：
                    淡色底 + 同色文字，位置和「进行中」一组，读起来是「属性」不是「装饰」。
                  -->
                  <!-- 标题 + 状态 -->
                  <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Name}"
                               FontSize="{DynamicResource FontSizeHeading}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0">
                      <Panel IsVisible="{Binding HasPriority}" VerticalAlignment="Center">
                        <Border Background="{Binding PriorityBrush}" Opacity="0.16" CornerRadius="4" />
                        <TextBlock Text="{Binding PriorityText, StringFormat={}{0}优先}"
                                   Margin="6,1"
                                   FontSize="{DynamicResource FontSizeMicro}"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding PriorityBrush}" />
                      </Panel>
                      <Border IsVisible="{Binding IsArchived}"
                              Padding="7,2"
                              CornerRadius="4"
                              Background="{DynamicResource SukiCardBackground}"
                              VerticalAlignment="Center">
                        <TextBlock Text="已归档"
                                   FontSize="{DynamicResource FontSizeMicro}"
                                   Foreground="{DynamicResource SukiMuteText}" />
                      </Border>
                      <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Ellipse Width="6"
                                 Height="6"
                                 Fill="{Binding StatusBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{DynamicResource SukiMuteText}" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>

                  <!-- 描述是辅助信息：弱化颜色、固定两行高度，卡片底部才能对齐 -->
                  <Border Grid.Row="1" Height="34" Margin="0,6,0,0">
                    <TextBlock Text="{Binding Description}"
                               Foreground="{DynamicResource SukiMuteText}"
                               MaxLines="2"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding HasDescription}" />
                  </Border>

                  <!-- 进度 + 统计：收窄进度环，把宽度让给统计文字。
                       原 120px 圆环占了近半张卡，看起来像进度仪表盘而不是项目卡。 -->
                  <Grid Grid.Row="2" ColumnDefinitions="72,*" ColumnSpacing="12" Margin="0,12,0,0">
                    <suki:CircleProgressBar Grid.Column="0"
                                            Width="72" Height="72"
                                            StrokeWidth="6"
                                            Value="{Binding Progress}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding ProgressText}"
                                 FontSize="{DynamicResource FontSizeSubhead}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource SukiLowText}" />
                    </suki:CircleProgressBar>

                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                      <TextBlock Text="{Binding MetaText}"
                                 FontSize="{DynamicResource FontSizeCaption}"
                                 Foreground="{DynamicResource SukiLowText}"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding OverdueText}"
                                 FontSize="{DynamicResource FontSizeCaption}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource SukiDangerColor}"
                                 IsVisible="{Binding HasOverdue}" />
                      <!-- 起止区间单独一行：和逾期数字挤在一行会被裁掉半句 -->
                      <TextBlock Text="{Binding DateRangeText}"
                                 FontSize="{DynamicResource FontSizeCaption}"
                                 Foreground="{DynamicResource SukiMuteText}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>

                  <!-- 操作：图标按钮挪到右侧，含义靠 tooltip 兜底；删除只在悬停时转红。
                       默认一律压成次要色 —— 之前「列表/编辑/归档」都是主色亮蓝、
                       删除是纯红，四张彩图并排比项目名还抢眼。 -->
                  <Border Grid.Row="3"
                          Margin="0,14,-16,-1"
                          Padding="12,6"
                          BorderThickness="0,1,0,0"
                          BorderBrush="{DynamicResource SurfaceDivider}">
                    <StackPanel Classes="card-actions"
                                 Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
                      <Button Classes="icon sm" Command="{Binding OpenTasksCommand}" ToolTip.Tip="查看该项目的任务列表">
                        <PathIcon Data="{x:Static controls:AppIcons.Tasks}" Width="18" Height="18" />
                      </Button>
                      <Button Classes="icon sm" Command="{Binding EditCommand}" ToolTip.Tip="编辑">
                        <PathIcon Data="{x:Static controls:AppIcons.Edit}" Width="18" Height="18" />
                      </Button>
                      <Button Classes="icon sm"
                              Command="{Binding ToggleArchiveCommand}"
                              ToolTip.Tip="{Binding ArchiveLabel}">
                        <Panel>
                          <PathIcon Data="{x:Static controls:AppIcons.Archive}" Width="18" Height="18" IsVisible="{Binding !IsArchived}" />
                          <PathIcon Data="{x:Static controls:AppIcons.Unarchive}" Width="18" Height="18" IsVisible="{Binding IsArchived}" />
                        </Panel>
                      </Button>
                      <Button Classes="icon sm danger" Command="{Binding DeleteCommand}" ToolTip.Tip="删除">
                        <PathIcon Data="{x:Static controls:AppIcons.Trash}" Width="18" Height="18" />
                      </Button>
                    </StackPanel>
                  </Border>

                </Grid>
              </suki:GlassCard>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 空状态 -->
        <Border IsVisible="{Binding ShowEmpty}"
                Padding="48"
                BorderThickness="1"
                BorderBrush="{DynamicResource SukiBorderBrush}">
          <StackPanel Spacing="7" HorizontalAlignment="Center">
            <TextBlock Text="还没有项目"
                       FontSize="{DynamicResource FontSizeSubhead}"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="建一个项目，把相关任务收在一起，进度会自动算。"
                       Foreground="{DynamicResource SukiMuteText}"
                       HorizontalAlignment="Center" />
            <Button Content="新建项目"
                    Classes="Flat"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0"
                    Command="{Binding NewProjectCommand}" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>



  </Grid>
</UserControl>
