<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WorkStation.App.ViewModels"
             xmlns:controls="using:WorkStation.App.Controls"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             x:Class="WorkStation.App.Views.RemindersView"
             x:DataType="vm:RemindersViewModel"
             x:CompileBindings="True">

  <!-- 提醒行与任务行共用同一套「数据行」外观（App.axaml 的全局 card-row 样式）。
       已到点不再整行铺警示底：一行行连起来会变成一大块橙色，
       整页看着像报错。改成行首一个 6px 琥珀点，时间本身也用警示色。 -->

  <UserControl.Resources>
    <!-- 三组共用同一套行模板：提醒行只有「状态标签 + 几个动作」这点差别，
         复制三份以后改一处忘两处 -->
    <DataTemplate x:Key="ReminderRow" x:DataType="vm:ReminderRowViewModel">
      <Border Classes="card-row">
        <!-- 列宽固定 10：未到点的行没有点，但缩进必须一致，否则同一组里两种左边界 -->
        <Grid ColumnDefinitions="10,*,Auto" ColumnSpacing="8">

          <Ellipse Width="6" Height="6"
                   Fill="{DynamicResource SukiWarningColor}"
                   IsVisible="{Binding IsTriggered}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}"
                       FontSize="{DynamicResource FontSizeBody}"
                       Foreground="{DynamicResource SukiText}"
                       TextWrapping="Wrap"
                       MaxLines="2"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="{Binding TimeText}"
                         FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{Binding TimeBrush}" />
              <TextBlock Text="·"
                         FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource SukiMuteText}" />
              <TextBlock Text="{Binding MetaText}"
                         FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource SukiMuteText}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="2"
                      Classes="card-actions"
                      Orientation="Horizontal"
                      Spacing="2"
                      VerticalAlignment="Center">
            <Button Classes="icon sm"
                    IsVisible="{Binding IsActionable}"
                    Command="{Binding CompleteCommand}"
                    ToolTip.Tip="标记完成">
              <PathIcon Data="{x:Static controls:AppIcons.Check}" Width="18" Height="18" />
            </Button>

            <Button Classes="icon sm"
                    IsVisible="{Binding IsTriggered}"
                    Command="{Binding SnoozeCommand}"
                    ToolTip.Tip="10 分钟后再提醒">
              <PathIcon Data="{x:Static controls:AppIcons.Clock}" Width="18" Height="18" />
            </Button>

            <Button Classes="icon sm danger"
                    Command="{Binding DeleteCommand}"
                    ToolTip.Tip="删除提醒">
              <PathIcon Data="{x:Static controls:AppIcons.Trash}" Width="18" Height="18" />
            </Button>
          </StackPanel>

        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*">

    <!--
      工具栏：与任务页、项目页同一套卡片式工具栏。
      之前这里是一行裸的 Grid（说明文字 + 按钮直接贴在页面上），
      和其它页的「卡片 + 内边距 + 主按钮靠右」对不上，
      按钮还因为 Flat 的阴影往下坠，看着像浮在页面中间而不是工具栏里。
    -->
    <Border Grid.Row="0"
            Classes="card"
            Margin="{DynamicResource PageGutterBelowHeader}"
            Padding="10,8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <TextBlock Text="任务设了截止时间和「提前提醒」，到点就会弹出来；也可以在这里排一条。"
                   Foreground="{DynamicResource SukiMuteText}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />

        <Button Grid.Column="1"
                Content="新建提醒"
                Classes="Flat"
                VerticalAlignment="Center"
                Command="{Binding NewReminderCommand}" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="{DynamicResource PageGutter}" Spacing="12">

        <suki:InfoBar IsVisible="{Binding HasError}" Message="{Binding Error}" Severity="Error" IsClosable="False" />

        <!-- 待办：已到点的排在最前 -->
        <StackPanel Spacing="2" IsVisible="{Binding HasActive}">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,0,4">
            <TextBlock Text="待办" FontSize="{DynamicResource FontSizeSubhead}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Padding="7,2"
                    CornerRadius="6"
                    Background="{DynamicResource SurfaceGlassSunken}"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding ActiveCountText}"
                         FontSize="{DynamicResource FontSizeMicro}"
                         Foreground="{DynamicResource SukiMuteText}" />
            </Border>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Active}"
                        ItemTemplate="{StaticResource ReminderRow}" />
        </StackPanel>

        <!-- 已完成：默认收起。它是存档，不是待办，不该和上面抢注意力 -->
        <StackPanel Spacing="4" IsVisible="{Binding HasHandled}">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,6,0,4">
            <TextBlock Text="已完成" FontSize="{DynamicResource FontSizeSubhead}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Padding="7,2"
                    CornerRadius="6"
                    Background="{DynamicResource SurfaceGlassSunken}"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding HandledCountText}"
                         FontSize="{DynamicResource FontSizeMicro}"
                         Foreground="{DynamicResource SukiMuteText}" />
            </Border>
            <Button Classes="ghost sm"
                    Command="{Binding ToggleHandledCommand}"
                    Content="{Binding HandledToggleText}" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Handled}"
                        ItemTemplate="{StaticResource ReminderRow}"
                        IsVisible="{Binding IsHandledExpanded}" />
        </StackPanel>

        <!-- 空态 -->
        <suki:GlassCard Classes="card"
                IsVisible="{Binding ShowEmpty}"
                Padding="28,32"
                HorizontalAlignment="Stretch">
          <StackPanel Spacing="8" HorizontalAlignment="Center">
            <PathIcon Data="{x:Static controls:AppIcons.Bell}" Width="30" Height="30"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SukiDisabledText}" />
            <TextBlock Text="还没有提醒"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="在任务里填上截止时间与「提前提醒」，到点就会弹出来；也可以在这里手动排一条。"
                       Foreground="{DynamicResource SukiMuteText}"
                       MaxWidth="420"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
          </StackPanel>
        </suki:GlassCard>

      </StackPanel>
    </ScrollViewer>



  </Grid>
</UserControl>
