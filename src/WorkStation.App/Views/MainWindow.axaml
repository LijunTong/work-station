<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WorkStation.App.ViewModels"
        xmlns:views="using:WorkStation.App.Views"
        xmlns:controls="using:WorkStation.App.Controls"
        x:Class="WorkStation.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="工作台 Work Station"
        Width="1280"
        Height="820"
        MinWidth="1024"
        MinHeight="640"
        Background="{DynamicResource BgBrush}">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:BoardViewModel">
      <views:BoardView />
    </DataTemplate>
    <DataTemplate DataType="vm:ProjectsViewModel">
      <views:ProjectsView />
    </DataTemplate>
    <DataTemplate DataType="vm:TasksViewModel">
      <views:TasksView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
  </Window.DataTemplates>

  <Grid ColumnDefinitions="236,*">

    <!-- 侧边栏 -->
    <Border Grid.Column="0" Background="{DynamicResource BgPanelBrush}">
      <Grid RowDefinitions="Auto,*,Auto">

        <StackPanel Margin="18,20,18,22" Spacing="10" Orientation="Horizontal">
          <Border Width="28"
                  Height="28"
                  CornerRadius="{DynamicResource RadiusMd}"
                  Background="{DynamicResource AccentBrush}"
                  VerticalAlignment="Center">
            <TextBlock Text="工"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AccentTextBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <StackPanel Spacing="1" VerticalAlignment="Center">
            <TextBlock Text="工作台" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="Work Station"
                       FontSize="10.5"
                       Foreground="{DynamicResource TextFaintBrush}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="12,0" Spacing="3">
          <Button Classes="nav"
                  Classes.active="{Binding IsBoardActive}"
                  Command="{Binding ShowBoardCommand}">
            <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="10">
              <!-- 看板列图标：三根竖条 -->
              <Canvas Width="16" Height="16" VerticalAlignment="Center">
                <Rectangle Canvas.Left="0" Canvas.Top="2" Width="4" Height="12" RadiusX="1.5" RadiusY="1.5" />
                <Rectangle Canvas.Left="6" Canvas.Top="5" Width="4" Height="9" RadiusX="1.5" RadiusY="1.5" />
                <Rectangle Canvas.Left="12" Canvas.Top="3" Width="4" Height="11" RadiusX="1.5" RadiusY="1.5" />
              </Canvas>
              <TextBlock Grid.Column="1" Text="看板" VerticalAlignment="Center" />
              <Border Grid.Column="2"
                      Classes="badge"
                      IsVisible="{Binding HasOverdueBadge}">
                <TextBlock Text="{Binding OverdueBadgeText}" />
              </Border>
            </Grid>
          </Button>

          <Button Classes="nav"
                  Classes.active="{Binding IsTasksActive}"
                  Command="{Binding ShowTasksCommand}">
            <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="10">
              <!-- 清单图标：三个圆点 + 三条横线 -->
              <Canvas Width="16" Height="16" VerticalAlignment="Center">
                <Rectangle Canvas.Left="0" Canvas.Top="2" Width="3" Height="3" RadiusX="1.5" RadiusY="1.5" />
                <Rectangle Canvas.Left="6" Canvas.Top="2.5" Width="10" Height="2" RadiusX="1" RadiusY="1" />
                <Rectangle Canvas.Left="0" Canvas.Top="6.5" Width="3" Height="3" RadiusX="1.5" RadiusY="1.5" />
                <Rectangle Canvas.Left="6" Canvas.Top="7" Width="10" Height="2" RadiusX="1" RadiusY="1" />
                <Rectangle Canvas.Left="0" Canvas.Top="11" Width="3" Height="3" RadiusX="1.5" RadiusY="1.5" />
                <Rectangle Canvas.Left="6" Canvas.Top="11.5" Width="6" Height="2" RadiusX="1" RadiusY="1" />
              </Canvas>
              <TextBlock Grid.Column="1" Text="任务" VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Button Classes="nav"
                  Classes.active="{Binding IsProjectsActive}"
                  Command="{Binding ShowProjectsCommand}">
            <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="10">
              <!-- 项目图标：一张大卡 + 两张小卡 -->
              <Canvas Width="16" Height="16" VerticalAlignment="Center">
                <Rectangle Canvas.Left="0" Canvas.Top="2" Width="16" Height="4" RadiusX="1.5" RadiusY="1.5" />
                <Rectangle Canvas.Left="0" Canvas.Top="8" Width="7" Height="6" RadiusX="1.5" RadiusY="1.5" />
                <Rectangle Canvas.Left="9" Canvas.Top="8" Width="7" Height="6" RadiusX="1.5" RadiusY="1.5" />
              </Canvas>
              <TextBlock Grid.Column="1" Text="项目" VerticalAlignment="Center" />
            </Grid>
          </Button>

        </StackPanel>

        <!-- 底部：设置从导航里拿掉，收进这里。版本号跟着一起放，
             让「这是哪个版本」不用翻设置页；值来自程序集，不在 XAML 里写死 -->
        <StackPanel Grid.Row="2" Margin="18,0,18,14" Spacing="9">
          <StackPanel Spacing="4">
            <TextBlock Text="Ctrl + K 命令面板"
                       FontSize="{DynamicResource FontMicro}"
                       Foreground="{DynamicResource TextDimBrush}" />
            <TextBlock Text="本地数据 · 不联网"
                       FontSize="{DynamicResource FontMicro}"
                       Foreground="{DynamicResource TextDimBrush}" />
          </StackPanel>

          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
            <Button Classes="icon"
                    Classes.tinted="{Binding IsSettingsActive}"
                    Command="{Binding ShowSettingsCommand}"
                    ToolTip.Tip="设置">
              <controls:Icon Kind="Settings" Size="15" />
            </Button>
            <TextBlock Grid.Column="1"
                       Text="{Binding VersionText}"
                       FontSize="{DynamicResource FontMicro}"
                       Foreground="{DynamicResource TextDimBrush}"
                       VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 内容区 -->
    <Border Grid.Column="1"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1,0,0,0">
      <Grid RowDefinitions="Auto,*">

        <!-- 标题 + 常驻快速添加：记录一件事不该先想「我现在在哪个页面」 -->
        <Grid Grid.Row="0"
              Margin="{DynamicResource PageHeaderPadding}"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="20">
          <StackPanel Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="{Binding PageTitle}" Classes="page-title" />
            <TextBlock Text="{Binding PageSubtitle}"
                       Classes="page-subtitle"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <Border Grid.Column="1"
                  Classes="composer"
                  Width="352"
                  VerticalAlignment="Center">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBox Name="QuickAddBox"
                       Grid.Column="0"
                       Classes="bare"
                       Text="{Binding QuickAddTitle, Mode=TwoWay}"
                       PlaceholderText="记一件事，回车添加…"
                       VerticalAlignment="Center">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding QuickAddCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
              <Button Grid.Column="1"
                      Classes="icon tinted"
                      Command="{Binding NewTaskCommand}"
                      ToolTip.Tip="详细新建（填截止时间、项目等）">
                <controls:Icon Kind="Plus" Size="13" />
              </Button>
            </Grid>
          </Border>
        </Grid>

        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
      </Grid>
    </Border>

    <!-- 命令面板 -->
    <views:CommandPaletteView Grid.ColumnSpan="2"
                              DataContext="{Binding Palette}"
                              IsVisible="{Binding IsOpen}" />

    <!-- 快捷键帮助 -->
    <Border Grid.ColumnSpan="2"
            IsVisible="{Binding IsShortcutHelpOpen}"
            Background="{DynamicResource ScrimBrush}">
      <Border Classes="card" Width="430" Padding="26" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="快捷键" Classes="section-title" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Classes="icon"
                    Command="{Binding CloseShortcutHelpCommand}"
                    ToolTip.Tip="关闭（Esc）">
              <controls:Icon Kind="Close" Size="13" />
            </Button>
          </Grid>

          <Grid ColumnDefinitions="96,*"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                RowSpacing="10">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="n" Classes="key" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="快速记录一件事" Classes="secondary" FontSize="{DynamicResource FontSm}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="/" Classes="key" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="聚焦当前页的搜索框" Classes="secondary" FontSize="{DynamicResource FontSm}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl + K" Classes="key" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="命令面板：跳转、新建、找任务" Classes="secondary" FontSize="{DynamicResource FontSm}" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="1 – 4" Classes="key" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="切换到对应页面" Classes="secondary" FontSize="{DynamicResource FontSm}" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Ctrl + Enter" Classes="key" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="保存当前抽屉" Classes="secondary" FontSize="{DynamicResource FontSm}" />
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Esc" Classes="key" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="关闭抽屉 / 浮层" Classes="secondary" FontSize="{DynamicResource FontSm}" />
            <TextBlock Grid.Row="6" Grid.Column="0" Text="?" Classes="key" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="显示或隐藏这份帮助" Classes="secondary" FontSize="{DynamicResource FontSm}" />
          </Grid>

          <TextBlock Text="看板里拖动卡片到另一列，就是改状态。"
                     Classes="dim"
                     FontSize="{DynamicResource FontXs}" />
        </StackPanel>
      </Border>
    </Border>

    <!-- Toast：黑底白字在浅色主题里太扎眼，改用面板色 + 细边框 -->
    <Border Grid.ColumnSpan="2"
            IsVisible="{Binding IsToastVisible}"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,32"
            Padding="16,11"
            CornerRadius="{DynamicResource RadiusMd}"
            BorderThickness="1"
            BorderBrush="{DynamicResource LineStrongBrush}"
            Background="{DynamicResource BgPanelBrush}"
            BoxShadow="0 8 26 0 #26000000">
      <TextBlock Text="{Binding ToastMessage}"
                 TextWrapping="Wrap"
                 MaxWidth="560"
                 FontSize="{DynamicResource FontSm}" />
    </Border>

    <!-- 启动失败：整个界面替换为错误页，避免用户对着空窗口猜 -->
    <Border Grid.ColumnSpan="2"
            IsVisible="{Binding HasStartupError}"
            Background="{DynamicResource BgBrush}">
      <Border Classes="card"
              Width="480"
              Padding="28"
              VerticalAlignment="Center"
              HorizontalAlignment="Center">
        <StackPanel Spacing="10">
          <TextBlock Text="无法启动工作台" Classes="section-title" />
          <TextBlock Text="{Binding StartupError}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontSize="{DynamicResource FontSm}"
                     TextWrapping="Wrap" />
          <TextBlock Text="数据库文件可能被占用或权限不足。检查数据目录后重新打开应用。"
                     Classes="dim"
                     FontSize="{DynamicResource FontXs}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Border>

  </Grid>
</Window>
