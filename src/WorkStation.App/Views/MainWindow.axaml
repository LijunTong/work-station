<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WorkStation.App.ViewModels"
        xmlns:views="using:WorkStation.App.Views"
        x:Class="WorkStation.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="工作台 Work Station"
        Width="1280"
        Height="820"
        MinWidth="1024"
        MinHeight="640"
        Background="{DynamicResource BgBrush}">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:ProjectsViewModel">
      <views:ProjectsView />
    </DataTemplate>
    <DataTemplate DataType="vm:TasksViewModel">
      <views:TasksView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
  </Window.DataTemplates>

  <Grid ColumnDefinitions="236,*">

    <!-- 侧边栏 -->
    <Border Grid.Column="0" Background="{DynamicResource BgPanelBrush}">
      <Grid RowDefinitions="Auto,*,Auto">

        <StackPanel Margin="18,20,18,22" Spacing="10" Orientation="Horizontal">
          <Border Width="28"
                  Height="28"
                  CornerRadius="8"
                  Background="{DynamicResource AccentBrush}"
                  VerticalAlignment="Center">
            <TextBlock Text="工"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AccentTextBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <StackPanel Spacing="1" VerticalAlignment="Center">
            <TextBlock Text="工作台" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="Work Station"
                       FontSize="10.5"
                       Foreground="{DynamicResource TextFaintBrush}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="12,0" Spacing="3">
          <Button Classes="nav"
                  Classes.active="{Binding IsProjectsActive}"
                  Command="{Binding ShowProjectsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <!-- 看板列图标：三根高低不同的竖条 -->
              <Canvas Width="16" Height="16" VerticalAlignment="Center">
                <Rectangle Canvas.Left="0" Canvas.Top="4" Width="4" Height="10" RadiusX="1.5" RadiusY="1.5" />
                <Rectangle Canvas.Left="6" Canvas.Top="1" Width="4" Height="13" RadiusX="1.5" RadiusY="1.5" />
                <Rectangle Canvas.Left="12" Canvas.Top="6" Width="4" Height="8" RadiusX="1.5" RadiusY="1.5" />
              </Canvas>
              <TextBlock Text="项目" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="nav"
                  Classes.active="{Binding IsTasksActive}"
                  Command="{Binding ShowTasksCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <!-- 清单图标：三个圆点 + 三条横线 -->
              <Canvas Width="16" Height="16" VerticalAlignment="Center">
                <Rectangle Canvas.Left="0" Canvas.Top="2" Width="3" Height="3" RadiusX="1.5" RadiusY="1.5" />
                <Rectangle Canvas.Left="6" Canvas.Top="2.5" Width="10" Height="2" RadiusX="1" RadiusY="1" />
                <Rectangle Canvas.Left="0" Canvas.Top="6.5" Width="3" Height="3" RadiusX="1.5" RadiusY="1.5" />
                <Rectangle Canvas.Left="6" Canvas.Top="7" Width="10" Height="2" RadiusX="1" RadiusY="1" />
                <Rectangle Canvas.Left="0" Canvas.Top="11" Width="3" Height="3" RadiusX="1.5" RadiusY="1.5" />
                <Rectangle Canvas.Left="6" Canvas.Top="11.5" Width="6" Height="2" RadiusX="1" RadiusY="1" />
              </Canvas>
              <TextBlock Text="任务" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="nav"
                  Classes.active="{Binding IsSettingsActive}"
                  Command="{Binding ShowSettingsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <!-- 滑块图标 -->
              <Canvas Width="16" Height="16" VerticalAlignment="Center">
                <Rectangle Canvas.Left="0" Canvas.Top="3" Width="16" Height="1.5" RadiusX="0.75" RadiusY="0.75" />
                <Rectangle Canvas.Left="0" Canvas.Top="7.5" Width="16" Height="1.5" RadiusX="0.75" RadiusY="0.75" />
                <Rectangle Canvas.Left="0" Canvas.Top="12" Width="16" Height="1.5" RadiusX="0.75" RadiusY="0.75" />
                <Rectangle Canvas.Left="10" Canvas.Top="1.2" Width="3" Height="5.2" RadiusX="1.5" RadiusY="1.5" />
                <Rectangle Canvas.Left="4" Canvas.Top="5.7" Width="3" Height="5.2" RadiusX="1.5" RadiusY="1.5" />
                <Rectangle Canvas.Left="9" Canvas.Top="10.2" Width="3" Height="5.2" RadiusX="1.5" RadiusY="1.5" />
              </Canvas>
              <TextBlock Text="设置" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="18,0,18,16" Spacing="3">
          <TextBlock Text="本地数据 · 不联网"
                     FontSize="10.5"
                     Foreground="{DynamicResource TextFaintBrush}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 内容区 -->
    <Border Grid.Column="1"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1,0,0,0">
      <Grid RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0"
                    Margin="{DynamicResource PageHeaderPadding}"
                    Spacing="3">
          <TextBlock Text="{Binding PageTitle}" Classes="page-title" />
          <TextBlock Text="{Binding PageSubtitle}" Classes="page-subtitle" />
        </StackPanel>

        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
      </Grid>
    </Border>

    <!-- Toast：黑底白字在浅色主题里太扎眼，改用面板色 + 细边框 -->
    <Border Grid.ColumnSpan="2"
            IsVisible="{Binding IsToastVisible}"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,32"
            Padding="16,11"
            CornerRadius="{DynamicResource RadiusMd}"
            BorderThickness="1"
            BorderBrush="{DynamicResource LineStrongBrush}"
            Background="{DynamicResource BgPanelBrush}"
            BoxShadow="0 8 26 0 #26000000">
      <TextBlock Text="{Binding ToastMessage}"
                 TextWrapping="Wrap"
                 MaxWidth="560"
                 FontSize="{DynamicResource FontSm}" />
    </Border>

    <!-- 启动失败：整个界面替换为错误页，避免用户对着空窗口猜 -->
    <Border Grid.ColumnSpan="2"
            IsVisible="{Binding HasStartupError}"
            Background="{DynamicResource BgBrush}">
      <Border Classes="card"
              Width="480"
              Padding="28"
              VerticalAlignment="Center"
              HorizontalAlignment="Center">
        <StackPanel Spacing="10">
          <TextBlock Text="无法启动工作台" Classes="section-title" />
          <TextBlock Text="{Binding StartupError}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontSize="{DynamicResource FontSm}"
                     TextWrapping="Wrap" />
          <TextBlock Text="数据库文件可能被占用或权限不足。检查数据目录后重新打开应用。"
                     Classes="dim"
                     FontSize="{DynamicResource FontXs}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Border>

  </Grid>
</Window>
