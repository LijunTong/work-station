<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WorkStation.App.ViewModels"
             xmlns:controls="using:WorkStation.App.Controls"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             x:Class="WorkStation.App.Views.TasksView"
             x:DataType="vm:TasksViewModel"
             x:CompileBindings="True">

  <!--
    任务行要有「一条数据」的边界。样式层删掉后 task-row 这个 class 一度完全没有外观，
    行看起来只是飘在空白里的文字。

    行的外观（圆角、描边、底色、内边距、以及「已完成变淡」）全部走 App.axaml 的全局
    card-row 样式，提醒页共用同一套。这里只留任务页特有的筛选按钮样式。
  -->
  <UserControl.Styles>
    <!-- 状态筛选：真正的 ToggleButton，选中态走 :checked，不再依赖 Suki 的 Outlined 类 -->
    <Style Selector="ToggleButton.filter">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleButton.filter:checked">
      <Setter Property="BorderBrush" Value="{DynamicResource SukiPrimaryColor}" />
      <!-- 选中态靠主色描边 + 字重表示，文字仍用正文色：
           文字也用主色的话，深色主题下是深蓝压深蓝，几乎看不清。 -->
      <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="{DynamicResource SukiControlTouchBackground}" />
    </Style>
    <Style Selector="ToggleButton.filter:pointerover">
      <Setter Property="Background" Value="{DynamicResource SukiControlTouchBackground}" />
    </Style>

    <!-- 行尾的编辑/删除按钮：默认不显示，鼠标移到这一行才浮出来。
         一屏十几行、每行两个药丸按钮，会把阅读节奏打断。
         用 Opacity 而不是 IsVisible：控件仍然可点，测试和键盘操作都不受影响。 -->
    <Style Selector="Border.card-row StackPanel.actions">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.card-row:pointerover StackPanel.actions">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="StackPanel.actions Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource SukiMuteText}" />
    </Style>
    <Style Selector="StackPanel.actions Button:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
      <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
    </Style>
    <Style Selector="Button.danger:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource SukiDangerColor}" />
    </Style>

    <!-- 分组标题行：透明底，悬停才有一层很淡的高亮。
         用 Basic 类会带上一块实心底色，区块感太强，反而像卡片标题。 -->
    <Style Selector="Button.group">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.group:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
    </Style>

    <!-- 「标记完成」的勾：默认是次要色，悬停才亮成完成色。
         之前用 Basic 类，整列都是主色亮蓝，比任务标题还抢眼。 -->
    <Style Selector="Button.complete">
      <Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.complete:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource SukiSuccessColor}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
    </Style>
  </UserControl.Styles>


  <Grid RowDefinitions="Auto,Auto,*">

    <!-- 筛选：状态用胶囊（选中态一眼可见），项目用下拉（选项会增长）。
         整条筛选栏收进一张卡，页面头和内容之间有一层明确的工具栏。
         下边距由 PageGutterBelowHeader 给 14：页面头已经给了上面的 14，
         两张卡之间必须有缝，贴着会像同一张卡被切了一刀。 -->
    <Border Grid.Row="0"
            Classes="card"
            Margin="{DynamicResource PageGutterBelowHeader}"
            Padding="10,8">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <ItemsControl ItemsSource="{Binding StatusFilters}" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StatusFilter">
              <ToggleButton Content="{Binding Label}"
                            Classes="filter"
                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            Command="{Binding SelectCommand}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ComboBox Grid.Column="1"
                  Margin="14,0,0,0"
                  Width="150"
                  ItemsSource="{Binding ProjectOptions}"
                  SelectedItem="{Binding SelectedProject, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ProjectOption">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBox Grid.Column="3"
                 Margin="12,0,0,0"
                 Width="180"
                 HorizontalAlignment="Right"
                 Tag="SearchBox"
                 Text="{Binding SearchText, Mode=TwoWay}"
                 PlaceholderText="搜索标题或备注…" />
      </Grid>
    </Border>

    <suki:InfoBar Grid.Row="1"
            IsVisible="{Binding HasError}"
            Margin="{DynamicResource PageGutter}" Message="{Binding Error}" Severity="Error" IsClosable="False" />

    <ScrollViewer Grid.Row="2">
      <StackPanel Margin="{DynamicResource PageGutterBottom}">

        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TaskGroupViewModel">
              <!-- 分组不再是"白卡"：一屏三四个大白框会互相稀释，什么都看不到。
                   改为页面上的区块 —— 一个标题行 + 一组带发丝分隔线的任务行。 -->
              <Border Padding="0" Margin="0,0,0,22">
                <StackPanel>

                <!-- 与任务行用同一套列宽，分组标题才能和下面的任务标题严格对齐。
                     必须 Stretch：Basic 按钮默认按内容宽度排，计数徽标会贴在标题后面。 -->
                <Button Classes="group Basic"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="10,6"
                        Command="{Binding ToggleCommand}">
                  <Grid ColumnDefinitions="12,20,*,Auto" ColumnSpacing="10">
                    <TextBlock Grid.Column="1"
                               Text="{Binding ArrowGlyph}"
                               FontSize="{DynamicResource FontSizeMicro}"
                               Foreground="{DynamicResource SukiDisabledText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding Title}"
                               FontSize="{DynamicResource FontSizeSubhead}"
                               FontWeight="SemiBold"
                               Foreground="{Binding TitleBrush}"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="3"
                            Padding="7,2"
                            CornerRadius="4"
                            Background="{DynamicResource SukiControlTouchBackground}"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding CountText}"
                                 FontSize="{DynamicResource FontSizeMicro}"
                                 Foreground="{DynamicResource SukiMuteText}" />
                    </Border>
                  </Grid>
                </Button>

                <ItemsControl ItemsSource="{Binding Tasks}" IsVisible="{Binding IsExpanded}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TaskRowViewModel">
                      <Border Classes="card-row" Classes.done="{Binding IsFinished}">
                        <Grid ColumnDefinitions="12,20,*,Auto,Auto" ColumnSpacing="8">

                          <!-- 优先级用 6px 圆点表示：之前是 3px 通高色条，
                               一段一段竖着的彩色线让整页看着像骨架屏。 -->
                          <Ellipse Width="6" Height="6"
                                   Fill="{Binding PriorityBrush}"
                                   IsVisible="{Binding HasPriority}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />

                          <Button Grid.Column="1"
                                  Classes="complete"
                                  Width="22" Height="22" Padding="0"
                                  CornerRadius="11"
                                  Command="{Binding CompleteCommand}"
                                  IsVisible="{Binding !IsFinished}"
                                  ToolTip.Tip="标记完成">
                            <PathIcon Data="{x:Static controls:AppIcons.Check}" Width="15" Height="15" />
                          </Button>
                          <TextBlock Grid.Column="1"
                                     Text="{Binding CheckGlyph}"
                                     IsVisible="{Binding IsFinished}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     FontSize="{DynamicResource FontSizeCaption}"
                                     Foreground="{DynamicResource SukiSuccessColor}" />

                          <StackPanel Grid.Column="2" Spacing="2" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       Foreground="{DynamicResource SukiText}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding MetaText}"
                                       IsVisible="{Binding HasMeta}"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource SukiMuteText}"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>

                          <TextBlock Grid.Column="3"
                                     Text="{Binding DueText}"
                                     FontSize="{DynamicResource FontSizeCaption}"
                                     Foreground="{Binding DueBrush}"
                                     VerticalAlignment="Center" />

                          <StackPanel Grid.Column="4"
                                      Classes="actions"
                                      Orientation="Horizontal"
                                      Spacing="1"
                                      VerticalAlignment="Center">
                            <Button Classes="icon sm"
                                    Command="{Binding EditCommand}"
                                    ToolTip.Tip="编辑">
                              <PathIcon Data="{x:Static controls:AppIcons.Edit}" Width="18" Height="18" />
                            </Button>
                            <Button Classes="icon sm danger"
                                    Command="{Binding DeleteCommand}"
                                    ToolTip.Tip="删除">
                              <PathIcon Data="{x:Static controls:AppIcons.Trash}" Width="18" Height="18" />
                            </Button>
                          </StackPanel>

                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 空状态 -->
        <Border Classes="card"
                IsVisible="{Binding ShowEmpty}"
                Margin="0,8,0,0"
                Padding="48">
          <StackPanel Spacing="7" HorizontalAlignment="Center">
            <TextBlock Text="没有符合条件的任务"
                       FontSize="{DynamicResource FontSizeSubhead}"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="换个筛选条件，或者在上面直接记一件新事。"
                       Foreground="{DynamicResource SukiMuteText}"
                       HorizontalAlignment="Center" />
            <Button Content="清除筛选"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0"
                    Command="{Binding ClearFiltersCommand}" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>



  </Grid>
</UserControl>
