<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WorkStation.App.ViewModels"
             x:Class="WorkStation.App.Views.TasksView"
             x:DataType="vm:TasksViewModel"
             x:CompileBindings="True">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseFormCommand}" />
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SaveFormCommand}" />
  </UserControl.KeyBindings>

  <Grid RowDefinitions="Auto,Auto,Auto,*">

    <!-- 快速添加：合成框把「图标 + 输入 + 次操作」收成一行，比裸输入框更像一个动作 -->
    <Border Grid.Row="0"
            Classes="composer"
            Margin="28,0,28,12">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <TextBlock Text="＋"
                   FontSize="15"
                   Foreground="{DynamicResource TextFaintBrush}"
                   VerticalAlignment="Center" />
        <TextBox Grid.Column="1"
                 Classes="bare"
                 Text="{Binding QuickAddTitle, Mode=TwoWay}"
                 PlaceholderText="记一件事，回车添加…"
                 VerticalAlignment="Center">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding QuickAddCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Grid.Column="2"
                Content="详细新建"
                Classes="ghost sm"
                Command="{Binding NewTaskCommand}" />
      </Grid>
    </Border>

    <!-- 筛选：状态用胶囊（选中态一眼可见），项目用下拉（选项会增长） -->
    <Grid Grid.Row="1"
          Margin="28,0,28,6"
          ColumnDefinitions="Auto,Auto,*,Auto">
      <ItemsControl ItemsSource="{Binding StatusFilters}" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="6" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:StatusFilter">
            <Button Content="{Binding Label}"
                    Classes="filter"
                    Classes.active="{Binding IsSelected}"
                    Command="{Binding SelectCommand}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ComboBox Grid.Column="1"
                Margin="14,0,0,0"
                Width="150"
                ItemsSource="{Binding ProjectOptions}"
                SelectedItem="{Binding SelectedProject, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ProjectOption">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBox Grid.Column="3"
               Margin="12,0,0,0"
               Width="180"
               Text="{Binding SearchText, Mode=TwoWay}"
               PlaceholderText="搜索标题或备注…" />
    </Grid>

    <Border Grid.Row="2"
            Classes="error-bar"
            IsVisible="{Binding HasError}"
            Margin="28,6,28,10">
      <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
    </Border>

    <ScrollViewer Grid.Row="3">
      <StackPanel Margin="{DynamicResource PagePadding}">

        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TaskGroupViewModel">
              <StackPanel Margin="0,0,0,12">

                <!-- 与任务行用同一套列宽，分组标题才能和下面的任务标题严格对齐 -->
                <Button Classes="group" Command="{Binding ToggleCommand}">
                  <Grid ColumnDefinitions="3,20,*,Auto" ColumnSpacing="10">
                    <TextBlock Grid.Column="1"
                               Text="{Binding ArrowGlyph}"
                               FontSize="10"
                               Foreground="{DynamicResource TextFaintBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding Title}"
                               FontSize="{DynamicResource FontSm}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Classes.urgent="{Binding IsUrgent}"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="3" Classes="chip">
                      <TextBlock Text="{Binding CountText}" />
                    </Border>
                  </Grid>
                </Button>

                <ItemsControl ItemsSource="{Binding Tasks}" IsVisible="{Binding IsExpanded}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TaskRowViewModel">
                      <Border Classes="task-row" Classes.done="{Binding IsFinished}">
                        <Grid ColumnDefinitions="3,20,*,Auto,Auto" ColumnSpacing="10">

                          <!-- 优先级色条：比「高/中/低」文字胶囊更快扫 -->
                          <Border Classes="priority-bar"
                                  Background="{Binding PriorityBrush}"
                                  IsVisible="{Binding HasPriority}" />

                          <Button Grid.Column="1"
                                  Classes="check"
                                  Command="{Binding CompleteCommand}"
                                  IsVisible="{Binding !IsFinished}"
                                  ToolTip.Tip="标记完成" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding CheckGlyph}"
                                     IsVisible="{Binding IsFinished}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     FontSize="12"
                                     Foreground="{DynamicResource SuccessBrush}" />

                          <StackPanel Grid.Column="2" Spacing="1" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="{DynamicResource FontBody}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding MetaText}"
                                       IsVisible="{Binding HasMeta}"
                                       FontSize="{DynamicResource FontXs}"
                                       Foreground="{DynamicResource TextDimBrush}"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>

                          <TextBlock Grid.Column="3"
                                     Text="{Binding DueText}"
                                     FontSize="{DynamicResource FontXs}"
                                     Classes.dim="{Binding ShowDueNormal}"
                                     Classes.urgent="{Binding IsOverdue}"
                                     VerticalAlignment="Center" />

                          <StackPanel Grid.Column="4"
                                      Classes="actions"
                                      Orientation="Horizontal"
                                      Spacing="1"
                                      VerticalAlignment="Center">
                            <Button Content="编辑"
                                    Classes="ghost sm"
                                    Command="{Binding EditCommand}" />
                            <Button Content="删除"
                                    Classes="ghost sm dangerish"
                                    Command="{Binding DeleteCommand}" />
                          </StackPanel>

                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 空状态 -->
        <Border IsVisible="{Binding ShowEmpty}"
                Margin="0,8,0,0"
                Padding="48"
                CornerRadius="{DynamicResource RadiusLg}"
                BorderThickness="1"
                BorderBrush="{DynamicResource LineBrush}">
          <StackPanel Spacing="7" HorizontalAlignment="Center">
            <TextBlock Text="没有符合条件的任务"
                       FontSize="15"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="换个筛选条件，或者在上面直接记一件新事。"
                       Classes="dim"
                       FontSize="{DynamicResource FontSm}"
                       HorizontalAlignment="Center" />
            <Button Content="清除筛选"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0"
                    Command="{Binding ClearFiltersCommand}" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- 表单抽屉 -->
    <Border Grid.RowSpan="4"
            IsVisible="{Binding IsFormOpen}"
            Background="{DynamicResource ScrimBrush}">
      <Border Classes="drawer"
              Width="480"
              HorizontalAlignment="Right">
        <ContentControl Content="{Binding Form}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:TaskFormViewModel">
              <Grid RowDefinitions="Auto,*,Auto">

                <Border Grid.Row="0"
                        Padding="22,18"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource LineBrush}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding TitleText}" Classes="section-title" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="✕" Classes="icon" Command="{Binding CancelCommand}" />
                  </Grid>
                </Border>

                <ScrollViewer Grid.Row="1">
                  <StackPanel Margin="22,18,22,22" Spacing="16">

                    <StackPanel Spacing="0">
                      <TextBlock Text="标题" Classes="label" />
                      <TextBox Text="{Binding Title, Mode=TwoWay}" PlaceholderText="要做的事" />
                    </StackPanel>

                    <StackPanel Spacing="0">
                      <TextBlock Text="备注" Classes="label" />
                      <TextBox Text="{Binding Notes, Mode=TwoWay}"
                               AcceptsReturn="True"
                               TextWrapping="Wrap"
                               MinHeight="68" />
                    </StackPanel>

                    <StackPanel Spacing="0">
                      <TextBlock Text="所属项目" Classes="label" />
                      <ComboBox ItemsSource="{Binding ProjectChoices}"
                                SelectedIndex="{Binding ProjectIndex, Mode=TwoWay}"
                                HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:ProjectOption">
                            <TextBlock Text="{Binding Name}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                      <StackPanel Spacing="0">
                        <TextBlock Text="状态" Classes="label" />
                        <ComboBox ItemsSource="{x:Static vm:TaskFormViewModel.StatusOptions}"
                                  SelectedIndex="{Binding StatusIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="0">
                        <TextBlock Text="优先级" Classes="label" />
                        <ComboBox ItemsSource="{x:Static vm:TaskFormViewModel.PriorityOptions}"
                                  SelectedIndex="{Binding PriorityIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                      </StackPanel>
                    </Grid>

                    <StackPanel Spacing="0">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,5">
                        <TextBlock Text="截止时间" Classes="label" Margin="0" />
                        <Button Grid.Column="1"
                                Content="清除"
                                Classes="ghost sm"
                                Padding="4,0"
                                Command="{Binding ClearDueCommand}"
                                IsVisible="{Binding HasDueDate}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <CalendarDatePicker SelectedDate="{Binding DueDate, Mode=TwoWay}"
                                            PlaceholderText="不设置"
                                            HorizontalAlignment="Stretch" />
                        <TimePicker Grid.Column="1"
                                    SelectedTime="{Binding DueTime, Mode=TwoWay}"
                                    ClockIdentifier="24HourClock"
                                    IsVisible="{Binding HasDueDate}" />
                      </Grid>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                      <StackPanel Spacing="0">
                        <TextBlock Text="提前提醒（分钟）" Classes="label" />
                        <TextBox Text="{Binding RemindBefore, Mode=TwoWay}" PlaceholderText="0" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="0">
                        <TextBlock Text="预估工时（小时）" Classes="label" />
                        <TextBox Text="{Binding Estimate, Mode=TwoWay}" PlaceholderText="2" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="0">
                        <TextBlock Text="实际工时（小时）" Classes="label" />
                        <TextBox Text="{Binding Spent, Mode=TwoWay}" PlaceholderText="1.5" />
                      </StackPanel>
                    </Grid>

                    <StackPanel Spacing="0" IsVisible="{Binding IsBlocked}">
                      <TextBlock Text="阻塞原因" Classes="label" />
                      <TextBox Text="{Binding BlockedReason, Mode=TwoWay}" PlaceholderText="卡在什么地方" />
                    </StackPanel>

                    <Border Classes="error-bar"
                            IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
                    </Border>

                  </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Padding="22,14"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource LineBrush}">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="取消" Command="{Binding CancelCommand}" />
                    <Button Content="保存" Classes="primary" Command="{Binding SaveCommand}" />
                  </StackPanel>
                </Border>

              </Grid>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </Border>
    </Border>

    <!-- 删除确认 -->
    <Border Grid.RowSpan="4"
            IsVisible="{Binding IsDeleteConfirmOpen}"
            Background="{DynamicResource ScrimBrush}">
      <Border Classes="card" Width="430" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="14">
          <TextBlock Text="删除任务？" Classes="section-title" />
          <StackPanel Spacing="5">
            <TextBlock Text="{Binding PendingDelete.Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="删除后无法恢复。"
                       Classes="dim"
                       FontSize="{DynamicResource FontSm}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="取消" Command="{Binding CancelDeleteCommand}" />
            <Button Content="删除" Classes="danger" Command="{Binding ConfirmDeleteCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

  </Grid>
</UserControl>
