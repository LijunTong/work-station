<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WorkStation.App.ViewModels"
             x:Class="WorkStation.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             x:CompileBindings="True">

  <ScrollViewer>
    <!-- 不设 MaxWidth：Avalonia 里 Stretch + MaxWidth 会把内容居中，
         导致卡片左边缘和页面标题对不齐。让三个分组和标题同处一条视觉轴。 -->
    <StackPanel Margin="{DynamicResource PagePadding}" Spacing="14">

      <!-- 外观 -->
      <Border Classes="group-panel" Padding="20,18">
        <StackPanel Spacing="14">
          <StackPanel Spacing="3">
            <TextBlock Text="外观" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="切换即时生效，重启后保持。"
                       Classes="dim"
                       FontSize="{DynamicResource FontXs}" />
          </StackPanel>

          <Border Classes="segment">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Content="跟随系统"
                      Classes="seg"
                      Classes.active="{Binding IsSystemTheme}"
                      Command="{Binding SetThemeCommand}"
                      CommandParameter="system" />
              <Button Content="浅色"
                      Classes="seg"
                      Classes.active="{Binding IsLightTheme}"
                      Command="{Binding SetThemeCommand}"
                      CommandParameter="light" />
              <Button Content="深色"
                      Classes="seg"
                      Classes.active="{Binding IsDarkTheme}"
                      Command="{Binding SetThemeCommand}"
                      CommandParameter="dark" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- 提醒 -->
      <Border Classes="group-panel" Padding="20,18">
        <StackPanel Spacing="14">
          <StackPanel Spacing="3">
            <TextBlock Text="提醒" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="到点会在窗口右下角弹出。关掉窗口后应用驻留托盘，提醒照常触发。"
                       Classes="dim"
                       FontSize="{DynamicResource FontXs}"
                       TextWrapping="Wrap" />
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="每日站会提醒" FontSize="{DynamicResource FontBody}" />
              <TextBlock Text="每天固定时间汇报昨日完成、逾期和今晚到期。"
                         Classes="dim"
                         FontSize="{DynamicResource FontXs}" />
            </StackPanel>
            <CheckBox Grid.Column="1"
                      Content="开启"
                      IsChecked="{Binding DailyReviewEnabled, Mode=TwoWay}"
                      VerticalAlignment="Center" />
          </Grid>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="站会时间"
                       Classes="dim"
                       FontSize="{DynamicResource FontSm}"
                       VerticalAlignment="Center" />
            <ComboBox Grid.Column="1"
                      Width="112"
                      ItemsSource="{Binding DailyReviewTimeOptions}"
                      SelectedItem="{Binding DailyReviewTime, Mode=TwoWay}"
                      IsEnabled="{Binding DailyReviewEnabled}" />
          </Grid>

          <Border Height="1" Background="{DynamicResource LineBrush}" />

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="关闭窗口时驻留托盘" FontSize="{DynamicResource FontBody}" />
              <TextBlock Text="关掉就是退出：不再接收提醒，直到下次打开。"
                         Classes="dim"
                         FontSize="{DynamicResource FontXs}" />
            </StackPanel>
            <CheckBox Grid.Column="1"
                      Content="驻留"
                      IsChecked="{Binding CloseToTray, Mode=TwoWay}"
                      VerticalAlignment="Center" />
          </Grid>

          <!-- 找不到托盘图标的用户，第一步都是「它是不是没生效」。Windows 11 默认把新图标塞进
               ^ 折叠区，不给这句话就只能靠猜 -->
          <TextBlock Text="图标在任务栏右下角。Windows 11 会把它收进 ^ 折叠区，拖出来就能常驻；退出请用托盘菜单里的「退出」。"
                     Classes="dim"
                     FontSize="{DynamicResource FontXs}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- 数据 -->
      <Border Classes="group-panel" Padding="20,18">
        <StackPanel Spacing="14">
          <StackPanel Spacing="3">
            <TextBlock Text="数据" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="全部数据保存在本机，不联网。退出应用后复制 data.db 即完成备份。"
                       Classes="dim"
                       FontSize="{DynamicResource FontXs}"
                       TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="0">
            <TextBlock Text="数据库" Classes="label" />
            <Border Background="{DynamicResource BgSunkenBrush}"
                    CornerRadius="{DynamicResource RadiusSm}"
                    Padding="10,8">
              <SelectableTextBlock Classes="mono" Text="{Binding DatabasePath}" />
            </Border>
          </StackPanel>

          <StackPanel Spacing="0">
            <TextBlock Text="备份目录" Classes="label" />
            <Border Background="{DynamicResource BgSunkenBrush}"
                    CornerRadius="{DynamicResource RadiusSm}"
                    Padding="10,8">
              <SelectableTextBlock Classes="mono" Text="{Binding BackupDirectory}" />
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 关于 -->
      <Border Classes="group-panel" Padding="20,18">
        <StackPanel Spacing="12">
          <TextBlock Text="关于" FontSize="14" FontWeight="SemiBold" />

          <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto" RowSpacing="8">
            <TextBlock Text="版本" Classes="dim" FontSize="{DynamicResource FontXs}" />
            <TextBlock Grid.Column="1" Text="{Binding Version}" FontSize="{DynamicResource FontXs}" />
            <TextBlock Grid.Row="1" Text="存储" Classes="dim" FontSize="{DynamicResource FontXs}" />
            <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       Text="SQLite 单文件 · WAL 模式"
                       FontSize="{DynamicResource FontXs}" />
          </Grid>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
