<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    控件样式层。约定：
      · 只用 class 选择器扩展，不改控件模板（Fluent 升级时不容易崩）
      · 悬停/按下状态一律显式声明 —— Avalonia 的 class 选择器比 Fluent 的
        Button:pointerover 更特化，不显式写就会出现「主按钮悬停变灰」这类层级错乱
      · 所有颜色走 DynamicResource，切主题不需要重建控件
  -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource BgBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!-- 逾期这类需要拉警报的标题 -->
  <Style Selector="TextBlock.urgent">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <!-- 页面大标题与副标题：用字号和颜色两级落差建立层级，不靠加粗堆砌 -->
  <Style Selector="TextBlock.page-title">
    <Setter Property="FontSize" Value="{DynamicResource FontDisplay}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.3" />
  </Style>

  <Style Selector="TextBlock.page-subtitle">
    <Setter Property="FontSize" Value="{DynamicResource FontSm}" />
    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
  </Style>

  <Style Selector="TextBlock.section-title">
    <Setter Property="FontSize" Value="{DynamicResource FontH2}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- 表单字段名 -->
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="{DynamicResource FontXs}" />
    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
    <Setter Property="Margin" Value="0,0,0,5" />
  </Style>

  <!-- ========== 按钮 ========== -->

  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource BgPanelBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Padding" Value="11,6" />
    <Setter Property="FontSize" Value="{DynamicResource FontSm}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
  </Style>

  <Style Selector="Button:pressed">
    <Setter Property="Background" Value="{DynamicResource BgSunkenBrush}" />
  </Style>

  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- 主操作：一屏只该有一个 -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="13,7" />
  </Style>

  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentStrongBrush}" />
  </Style>

  <Style Selector="Button.primary:pressed">
    <Setter Property="Background" Value="{DynamicResource AccentStrongBrush}" />
  </Style>

  <!-- 破坏性操作：只用在二次确认弹窗里，不进列表 -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.danger:pointerover">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
    <Setter Property="Opacity" Value="0.88" />
  </Style>

  <!-- 图标按钮：正方形。里面放 Controls:Icon，图标颜色继承 Foreground，
       所以悬停、危险、强调三种状态的换色只写在按钮上就够了 -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.icon:pointerover">
    <Setter Property="Background" Value="{DynamicResource BgSunkenBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <!-- 行内小图标：跟着任务行/卡片操作行的密度走 -->
  <Style Selector="Button.icon.sm">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
  </Style>

  <!-- 破坏性操作：静止时与普通图标一致，悬停才转红 -->
  <Style Selector="Button.icon.dangerish:pointerover">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <!-- 浅强调图标：合成框这类「必须一眼看出是按钮」的位置。
       类名不能叫 accent —— Fluent 主题自带 Button.accent，会盖成系统蓝实底按钮 -->
  <Style Selector="Button.icon.tinted">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <!-- 深色下 AccentSoft 与 BgPanel 只差一档明度，只靠底色仍旧看不出是按钮，
         补一圈描边把轮廓立起来 -->
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Button.icon.tinted:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <!-- ========== 输入控件 ========== -->

  <!--
    输入框规范（改这里即全站生效）：
      · 值文字 FontInput（14）+ TextBrush，比正文大半档 —— 用户自己敲进去的内容是这一屏的重点
      · 占位文字 TextDimBrush（4.9:1）：比正文弱一档但读得清。早先沿用 Fluent 默认的
        浅灰只有 2.2:1，整行看着像「说明看不清、字段是空的」
      · 描边用 InputLineBrush，比常规分隔线重；悬停再深一档，聚焦换强调色
      · 光标与选区都用强调色系，定位点要一眼能找到
  -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource BgPanelBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputLineBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="FontSize" Value="{DynamicResource FontInput}" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource TextDimBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource TextSelectionBrush}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style Selector="TextBox:pointerover:not(.bare)">
    <Setter Property="BorderBrush" Value="{DynamicResource InputLineHoverBrush}" />
  </Style>

  <Style Selector="TextBox:pointerover:not(.bare) /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource InputLineHoverBrush}" />
  </Style>

  <!-- 聚焦描边只给「自带底色的常规输入框」。
       裸输入框外面已经有容器，容器自己会亮边（Border.composer:focus-within）；
       给裸输入框加 1px 描边会直接压在文字上，把首字切掉。 -->
  <Style Selector="TextBox:focus:not(.bare) /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- 嵌在合成框里的裸输入：不要底色和描边，交给外层容器 -->
  <Style Selector="TextBox.bare">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="{DynamicResource FontInput}" />
    <!-- 必须显式居中：默认按顶部排列时，文字行会被 MinHeight 撑出 24px 高，
         行框内文字贴在顶部绘制，占位文字比同一行的按钮文字高 2.5px -->
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource BgPanelBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputLineBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="FontSize" Value="{DynamicResource FontInput}" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource TextDimBrush}" />
  </Style>

  <Style Selector="ComboBox:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource InputLineHoverBrush}" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="FontSize" Value="{DynamicResource FontSm}" />
    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
    <Setter Property="MinHeight" Value="30" />
  </Style>

  <Style Selector="CheckBox:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <!-- ========== 侧边栏导航 ========== -->

  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <!-- Stretch 而不是 Left：徽标要靠右对齐，文字仍在第一列靠左 -->
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="11,8" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
  </Style>

  <Style Selector="Button.nav:pointerover">
    <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.nav.active:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <!-- 图标用 Rectangle 拼，颜色必须跟着按钮状态走，否则选中项只有文字变蓝 -->
  <Style Selector="Button.nav Rectangle">
    <Setter Property="Fill" Value="{DynamicResource TextFaintBrush}" />
  </Style>

  <Style Selector="Button.nav.active Rectangle">
    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- 设置页的分段控件 -->
  <Style Selector="Border.segment">
    <Setter Property="Background" Value="{DynamicResource BgSunkenBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style Selector="Button.seg">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Padding" Value="14,5" />
    <Setter Property="FontSize" Value="{DynamicResource FontSm}" />
  </Style>

  <Style Selector="Button.seg:pointerover">
    <Setter Property="Background" Value="{DynamicResource BgPanelBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style Selector="Button.seg.active">
    <Setter Property="Background" Value="{DynamicResource BgPanelBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- 状态筛选胶囊 -->
  <Style Selector="Button.filter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Padding" Value="11,4" />
    <Setter Property="FontSize" Value="{DynamicResource FontXs}" />
  </Style>

  <Style Selector="Button.filter:pointerover">
    <Setter Property="Background" Value="{DynamicResource BgSunkenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style Selector="Button.filter.active">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.filter.active:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- ========== 日期字段 ========== -->

  <!--
    日期/时间不再是「原生日历选择器 + 原生时间选择器」两颗控件叠在一起：
    那套模板自带一整个带边框的日历图标按钮，撑在字段右侧像贴了块膏药，
    两颗控件还各自带一套圆角和内边距。现在统一成一个字段：
    左侧日历图标 + 值文字 + 右侧清除按钮，点开是「日历 + 时间」同一个浮层。
  -->
  <Style Selector="Button.field">
    <Setter Property="Background" Value="{DynamicResource BgPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="FontSize" Value="{DynamicResource FontInput}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.field:pointerover">
    <Setter Property="Background" Value="{DynamicResource BgPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputLineHoverBrush}" />
  </Style>

  <!-- Fluent 的 Button 模板在 pointerover 时改的是模板里那层 ContentPresenter 的底色，
       控件级 Background 压不住它 —— 表现就是深色下鼠标扫过日期字段，底色突然比输入框亮一档 -->
  <Style Selector="Button.field /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputLineBrush}" />
  </Style>

  <Style Selector="Button.field:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputLineHoverBrush}" />
  </Style>

  <Style Selector="Button.field:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgSunkenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Button.field:pressed">
    <Setter Property="Background" Value="{DynamicResource BgPanelBrush}" />
  </Style>

  <Style Selector="Button.field:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- 字段里的「未设置」占位与输入框同一条规范 -->
  <Style Selector="Button.field TextBlock.placeholder">
    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
  </Style>

  <!-- 浮层里的便捷项：今天 / 明天 -->
  <Style Selector="Button.quick">
    <Setter Property="Background" Value="{DynamicResource BgSunkenBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="FontSize" Value="{DynamicResource FontXs}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="Button.quick:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- 浮层容器：与卡片同一层级，但没有卡片那么重的阴影 -->
  <Style Selector="Border.popover">
    <Setter Property="Background" Value="{DynamicResource BgPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="BoxShadow" Value="0 10 30 0 #26000000" />
  </Style>

  <!-- ========== 容器 ========== -->

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource BgPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource BgPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
  </Style>

  <Style Selector="Border.drawer">
    <Setter Property="Background" Value="{DynamicResource BgPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="BoxShadow" Value="-18 0 40 0 #14000000" />
  </Style>

  <!-- 快速添加合成框：把图标、输入、次操作收进一个描边容器里 -->
  <Style Selector="Border.composer">
    <Setter Property="Background" Value="{DynamicResource BgPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="12,6" />
  </Style>

  <Style Selector="Border.composer:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
  </Style>

  <!-- 焦点落在里面的输入框时，亮的是整个容器：既保留「正在输入」的反馈，
       又不会出现一条压在文字上的描边 -->
  <Style Selector="Border.composer:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- 设置页的分组容器：比卡片更「平」，靠间距而不是描边分隔 -->
  <Style Selector="Border.group-panel">
    <Setter Property="Background" Value="{DynamicResource BgPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <!-- 路径、版本号这类等宽内容 -->
  <Style Selector="SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontXs}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- ========== 列表 ========== -->

  <Style Selector="Border.task-row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Padding" Value="8,8" />
  </Style>

  <Style Selector="Border.task-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
  </Style>

  <!-- 行内操作默认压低存在感，指针进入该行才恢复 —— 否则每行都是「编辑 删除」，噪声盖过内容 -->
  <Style Selector="Border.task-row StackPanel.actions">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="Border.task-row:pointerover StackPanel.actions">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- 提醒页的「待处理」行：暖底 + 琥珀竖条，扫一眼就知道哪几条还压着 -->
  <Style Selector="Border.task-row.alert">
    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
  </Style>

  <Style Selector="Border.task-row.alert:pointerover">
    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
  </Style>

  <!-- 已完成/已取消：灰显、不再提供操作入口 -->
  <Style Selector="Border.task-row.done">
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <!-- 行内完成圆点 -->
  <Style Selector="Button.check">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="MinHeight" Value="18" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.check:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
  </Style>

  <Style Selector="Button.check:pressed">
    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
  </Style>

  <!-- 优先级色条：比一个「高/中/低」文字胶囊更好扫 -->
  <Style Selector="Border.priority-bar">
    <Setter Property="Width" Value="3" />
    <Setter Property="CornerRadius" Value="1.5" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="0,2" />
  </Style>

  <!-- 分组标题 -->
  <Style Selector="Button.group">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
  </Style>

  <Style Selector="Button.group:pointerover">
    <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
  </Style>

  <!-- 小胶囊 -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource BgSunkenBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.chip TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontMicro}" />
    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
  </Style>

  <!-- 错误条 -->
  <Style Selector="Border.error-bar">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Padding" Value="12,9" />
  </Style>

  <Style Selector="Border.error-bar TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontXs}" />
  </Style>

  <!-- ========== 看板 ========== -->

  <!-- 概览条上的数字胶囊：数字比标签更重，扫一眼就知道哪里堆了事 -->
  <Style Selector="Button.stat">
    <Setter Property="Background" Value="{DynamicResource BgPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="12,5" />
  </Style>

  <Style Selector="Button.stat:pointerover">
    <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
  </Style>

  <Style Selector="Button.stat.active">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Button.stat.active:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Border.column">
    <Setter Property="Background" Value="{DynamicResource BgColumnBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
    <Setter Property="Padding" Value="9" />
  </Style>

  <!-- 拖拽悬停：整列换底色 + 强调色描边，比给卡片加虚线框更容易看清落点 -->
  <Style Selector="Border.column.droptarget">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Border.board-card">
    <Setter Property="Background" Value="{DynamicResource BgPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="10,9" />
  </Style>

  <Style Selector="Border.board-card:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
  </Style>

  <!-- ========== 命令面板 ========== -->

  <Style Selector="Border.palette">
    <Setter Property="Background" Value="{DynamicResource BgPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
    <Setter Property="BoxShadow" Value="0 20 54 0 #33000000" />
  </Style>

  <Style Selector="Button.palette-row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Padding" Value="9,7" />
  </Style>

  <Style Selector="Button.palette-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
  </Style>

  <Style Selector="Button.palette-row.active">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <Style Selector="Button.palette-row.active:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <!-- 快捷键说明里的按键 -->
  <Style Selector="TextBlock.key">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontXs}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ========== 侧边栏徽标 ========== -->

  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontMicro}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

</Styles>
