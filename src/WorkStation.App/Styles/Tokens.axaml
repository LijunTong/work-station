<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    设计令牌。三层结构：
      1. 颜色（浅/深各一套 ThemeDictionary，控件侧一律 DynamicResource，切主题即时生效）
      2. 字号阶梯（display / h2 / body / sm / xs / micro）
      3. 圆角与间距常量

    取色口径：强调色只用一个，其余全靠中性灰拉开层次；状态色只用于「确实需要报警」
    的地方（逾期、阻塞、错误），不做装饰。所有正文色对背景的对比度 ≥ 4.5:1，
    淡色（TextFaintBrush）只允许出现在图标、分隔线这类非文本元素上。
  -->
  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <!-- 表面：页面底色比分层面略深一档，卡片才浮得起来 -->
      <SolidColorBrush x:Key="BgBrush" Color="#F5F6F9" />
      <SolidColorBrush x:Key="BgPanelBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="BgSunkenBrush" Color="#EDEFF4" />
      <SolidColorBrush x:Key="BgHoverBrush" Color="#F1F3F8" />
      <!-- 看板列：比页面深一档、比卡片浅一档，卡片才像「摆在托盘里」 -->
      <SolidColorBrush x:Key="BgColumnBrush" Color="#EAEDF4" />

      <SolidColorBrush x:Key="LineBrush" Color="#E4E7EE" />
      <SolidColorBrush x:Key="LineStrongBrush" Color="#D3D8E2" />
      <!-- 输入框描边比常规分隔线重一档：字段需要轮廓才知道「这里可以打字」 -->
      <SolidColorBrush x:Key="InputLineBrush" Color="#CBD3E0" />
      <SolidColorBrush x:Key="InputLineHoverBrush" Color="#A9B4C6" />
      <SolidColorBrush x:Key="TextSelectionBrush" Color="#CFDCFB" />

      <!-- 文本：正文 / 次要 / 元信息 / 装饰 -->
      <SolidColorBrush x:Key="TextBrush" Color="#12161D" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#3F4855" />
      <SolidColorBrush x:Key="TextDimBrush" Color="#667085" />
      <SolidColorBrush x:Key="TextFaintBrush" Color="#98A2B3" />

      <!-- 强调色 #2F62E8 对白底 5.2:1，白字压其上同样 5.2:1 -->
      <SolidColorBrush x:Key="AccentBrush" Color="#2F62E8" />
      <SolidColorBrush x:Key="AccentStrongBrush" Color="#2450C4" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#EBF0FE" />
      <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />

      <SolidColorBrush x:Key="DangerBrush" Color="#C0392F" />
      <SolidColorBrush x:Key="DangerSoftBrush" Color="#FBECEA" />
      <SolidColorBrush x:Key="WarningBrush" Color="#9A5B06" />
      <SolidColorBrush x:Key="WarningSoftBrush" Color="#FBF1E2" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#0F7A57" />
      <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E6F4EE" />

      <!-- 抽屉与弹层的遮罩；太黑会显得界面在「关灯」 -->
      <SolidColorBrush x:Key="ScrimBrush" Color="#4D0B1020" />
      <Color x:Key="ShadowColor">#12000000</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="BgBrush" Color="#0E1116" />
      <SolidColorBrush x:Key="BgPanelBrush" Color="#161A21" />
      <SolidColorBrush x:Key="BgSunkenBrush" Color="#1C222C" />
      <SolidColorBrush x:Key="BgHoverBrush" Color="#1F2631" />
      <!-- 深色下「抬升」靠变亮：页面 #0E1116 → 列 #131820 → 卡片 #161A21 -->
      <SolidColorBrush x:Key="BgColumnBrush" Color="#131820" />

      <SolidColorBrush x:Key="LineBrush" Color="#262D39" />
      <SolidColorBrush x:Key="LineStrongBrush" Color="#34404F" />
      <SolidColorBrush x:Key="InputLineBrush" Color="#3D4A5C" />
      <SolidColorBrush x:Key="InputLineHoverBrush" Color="#55647C" />
      <SolidColorBrush x:Key="TextSelectionBrush" Color="#2B4270" />

      <SolidColorBrush x:Key="TextBrush" Color="#E9ECF2" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C2CAD6" />
      <SolidColorBrush x:Key="TextDimBrush" Color="#8B95A6" />
      <SolidColorBrush x:Key="TextFaintBrush" Color="#5E6878" />

      <!-- 深色下强调色提亮：深底上的蓝若沿用浅色值会糊成一团 -->
      <SolidColorBrush x:Key="AccentBrush" Color="#6E97FF" />
      <SolidColorBrush x:Key="AccentStrongBrush" Color="#8FB0FF" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#18243D" />
      <SolidColorBrush x:Key="AccentTextBrush" Color="#0B1020" />

      <SolidColorBrush x:Key="DangerBrush" Color="#F0796F" />
      <SolidColorBrush x:Key="DangerSoftBrush" Color="#331C1C" />
      <SolidColorBrush x:Key="WarningBrush" Color="#E3A44A" />
      <SolidColorBrush x:Key="WarningSoftBrush" Color="#33260F" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#43C793" />
      <SolidColorBrush x:Key="SuccessSoftBrush" Color="#12291F" />

      <SolidColorBrush x:Key="ScrimBrush" Color="#A6000000" />
      <Color x:Key="ShadowColor">#66000000</Color>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!-- 跨平台字体栈：Windows 优先微软雅黑，macOS 走苹方，Linux 用随包分发的 Noto Sans SC 兜底 -->
  <FontFamily x:Key="AppFontFamily">Microsoft YaHei UI, PingFang SC, Noto Sans SC, Segoe UI, system-ui</FontFamily>
  <!-- 等宽：只用于路径、版本号这类需要逐字符对齐的内容 -->
  <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>

  <!-- 字号阶梯：6 档够用，再多就是没有阶梯 -->
  <x:Double x:Key="FontDisplay">22</x:Double>
  <x:Double x:Key="FontH2">16</x:Double>
  <x:Double x:Key="FontBody">13.5</x:Double>
  <!-- 输入值是「用户自己敲进去的内容」，比正文大半档，让输入区成为视线落点 -->
  <x:Double x:Key="FontInput">14</x:Double>
  <x:Double x:Key="FontSm">12.5</x:Double>
  <x:Double x:Key="FontXs">11.5</x:Double>
  <x:Double x:Key="FontMicro">10.5</x:Double>

  <!--
    圆角：三档 + 一个真圆。数值只跟「层级」有关，跟控件高度无关 ——
    早先的 6/9/14 让 14px 的卡片和 40px 的列都圆得像移动端气泡，
    而且同一排按钮和输入框因为高度不同，圆角视觉上深浅不一。
      4 = 控件（按钮、输入框、下拉、图标按钮、筛选胶囊、行）
      6 = 内嵌容器（合成框、统计块、看板卡片、任务卡）
      8 = 页面级容器（卡片、看板列、命令面板、对话框）
  -->
  <CornerRadius x:Key="RadiusSm">4</CornerRadius>
  <CornerRadius x:Key="RadiusMd">6</CornerRadius>
  <CornerRadius x:Key="RadiusLg">8</CornerRadius>
  <!-- 只给「本身就是圆」的小元素：数字徽标、完成圆点 -->
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>

  <!-- 页面统一左右内边距，改一处即全站对齐 -->
  <Thickness x:Key="PagePadding">28,0,28,24</Thickness>
  <Thickness x:Key="PageHeaderPadding">28,24,28,18</Thickness>
  <!-- 看板列自带 12 的右侧间距，这里少给 12，最后一列的右缘才与标题、搜索框对齐 -->
  <Thickness x:Key="BoardPadding">28,0,16,24</Thickness>

</ResourceDictionary>
