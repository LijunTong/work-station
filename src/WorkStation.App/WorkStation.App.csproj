<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WorkStation.App</RootNamespace>
    <!-- 保持 ASCII：中文 exe 名会让 WPF/Avalonia 生成的资源 URI 全部失效 -->
    <AssemblyName>WorkStation</AssemblyName>
    <Version>1.0.2</Version>
    <!-- exe 与窗口图标：托盘也复用同一份 Assets/app.png -->
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <!-- 源码是 UTF-8 无 BOM；不声明代码页时 Roslyn 会按系统 ANSI（中文 Windows 是 GBK）解码，中文标识符直接读坏 -->
    <CodePage>65001</CodePage>
    <!-- 编译期校验绑定路径：写错 x:DataType 下的属性名在 build 期就报错 -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!--
      运行时回退：默认策略是 Minor（同 major 内滚动补丁），跨 major 是不允许的 ——
      机器上只有 .NET 9 时，本应用（要 .NET 10）会直接起不来。
      改成 LatestMajor 后，装了更高版本（12.x、13.x…）的机器照样能跑，
      启动器的检测口径也据此定成「主版本 ≥ 10 即算满足」。
    -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="SukiUI" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorkStation.Core\WorkStation.Core.csproj" />
  </ItemGroup>

  <!-- 单元测试要验单实例的互斥量判定，只放开给测试程序集 -->
  <ItemGroup>
    <InternalsVisibleTo Include="WorkStation.Tests" />
  </ItemGroup>

  <!-- 应用图标：托盘与窗口共用，按 avares://WorkStation/Assets/app.png 取 -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\app.png" />
  </ItemGroup>

  <!-- 中文字体等资源放在仓库根 assets/ 下，按需嵌入 -->
  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\fonts\**" Link="Assets/Fonts/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- TaskStatus 与 System.Threading.Tasks.TaskStatus 同名，隐式 using 下会 CS0104 二义 -->
  <ItemGroup>
    <Using Include="TaskStatus = WorkStation.Core.Models.TaskStatus" />
  </ItemGroup>

</Project>
