<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WorkStation.App.Controls"
             x:Class="WorkStation.App.Controls.DueDateField">

  <!--
    日期/时间字段。视觉上就是一颗「输入框」：图标 + 值 + 清除，
    点开是同一个浮层里的日历 + 时间，避免抽屉里同时出现两套不同长相的原生选择器。
  -->
  <Grid>
    <Button Name="FieldButton"
            Classes="field"
            Click="OnFieldClick">
      <Grid ColumnDefinitions="Auto,*,22" ColumnSpacing="8">
        <controls:Icon Kind="Calendar"
                       Size="14"
                       Foreground="{DynamicResource TextDimBrush}"
                       VerticalAlignment="Center" />
        <TextBlock Name="ValueText"
                   Grid.Column="1"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </Grid>
    </Button>

    <!-- 清除按钮与字段平级而不是放在里面：按钮套按钮会互相吞点击 -->
    <Button Name="ClearButton"
            Classes="icon sm"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Margin="0,0,5,0"
            IsVisible="False"
            ToolTip.Tip="清除日期"
            Click="OnClearClick">
      <controls:Icon Kind="Close" Size="11" />
    </Button>

    <Popup Name="Pop"
           Placement="BottomEdgeAlignedLeft"
           VerticalOffset="6"
           IsLightDismissEnabled="True">
      <!-- 日历在左、时间在右：竖着堆会把浮层撑到 450 高，抽屉里的字段在中段，
           下方放不下就只能往上翻，结果浮层跑到窗口顶部 -->
      <Border Classes="popover" Width="432">
        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="12">

          <Calendar Name="Cal" Grid.Column="0" VerticalAlignment="Top" />

          <StackPanel Grid.Column="1" Width="116" Spacing="8">
            <StackPanel Name="TimeRow" Spacing="4">
              <TextBlock Text="时间" Classes="label" Margin="0" />
              <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="4">
                <ComboBox Name="HourBox" Grid.Column="0" />
                <TextBlock Grid.Column="1"
                           Text=":"
                           Classes="secondary"
                           VerticalAlignment="Center" />
                <ComboBox Name="MinuteBox" Grid.Column="2" />
              </Grid>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource LineBrush}" />

            <Button Content="今天" Classes="quick" HorizontalAlignment="Stretch" Click="OnTodayClick" />
            <Button Content="明天" Classes="quick" HorizontalAlignment="Stretch" Click="OnTomorrowClick" />
            <Button Content="完成" HorizontalAlignment="Stretch" Click="OnDoneClick" />
          </StackPanel>

        </Grid>
      </Border>
    </Popup>
  </Grid>
</UserControl>
