<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WorkStation.Core</RootNamespace>
    <AssemblyName>WorkStation.Core</AssemblyName>
  </PropertyGroup>

  <!-- 数据层零 UI 依赖：Core 不引用任何 Avalonia / Windows 包，保持框架无关 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- 显式钉版本：Microsoft.Data.Sqlite 的传递依赖最低版本在本机 NuGet 缓存里缺失 -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

</Project>
