<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WorkStation.Core</RootNamespace>
    <AssemblyName>WorkStation.Core</AssemblyName>
    <!-- 源码是 UTF-8 无 BOM；不声明代码页时 Roslyn 会按系统 ANSI（中文 Windows 是 GBK）解码，中文标识符直接读坏 -->
    <CodePage>65001</CodePage>
  </PropertyGroup>

  <!-- 数据层零 UI 依赖：Core 不引用任何 Avalonia / Windows 包，保持框架无关 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- 显式钉版本：Microsoft.Data.Sqlite 的传递依赖最低版本在本机 NuGet 缓存里缺失 -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <!-- TaskStatus 与 System.Threading.Tasks.TaskStatus 同名，隐式 using 下会 CS0104 二义；
       全局别名优先级高于命名空间导入，一次声明覆盖全项目。 -->
  <ItemGroup>
    <Using Include="TaskStatus = WorkStation.Core.Models.TaskStatus" />
  </ItemGroup>

</Project>
